#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 2 ]; then
    echo "Usage: spawn-agent <session-name> <task-description>" >&2
    exit 1
fi

SESSION_NAME="$1"
shift
PROMPT="$*"

# Get host project directory (current directory when spawn-agent is invoked)
HOST_DIR="$(pwd)"

# Create agent workspace inside host project
AGENT_DIR="$HOST_DIR/.cocode/agents/$SESSION_NAME"
mkdir -p "$AGENT_DIR"

# Write prompt file (for reference)
printf '%s\n' "$PROMPT" > "$AGENT_DIR/prompt.txt"

# Get parent tmux session
PARENT=$(tmux display-message -p '#S' 2>/dev/null || echo "unknown")

# Launch tmux session with bash first (same as main agent approach).
# Starting cocode directly as the tmux command breaks send-keys input.
# Set TMPDIR to the agent workspace to avoid /tmp permission issues.
tmux new-session -d -s "$SESSION_NAME" \
  -e "PARENT_SESSION=$PARENT" \
  -e "AGENT_ID=$SESSION_NAME" \
  -e "AGENT_WORKSPACE=$AGENT_DIR" \
  -e "TMPDIR=$AGENT_DIR/tmp" \
  "cd '$HOST_DIR' && exec bash"

# Create tmp dir inside agent workspace
mkdir -p "$AGENT_DIR/tmp"

# Start cocode inside the bash session
sleep 2
tmux send-keys -t "$SESSION_NAME" "cocode" Enter

# Wait for cocode to be ready before sending the prompt
sleep 15
tmux send-keys -t "$SESSION_NAME" "$PROMPT" Enter

echo "Spawned: $SESSION_NAME"
echo "Workspace: $AGENT_DIR"
