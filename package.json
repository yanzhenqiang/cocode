{
  "name": "@yanzhenqiang/cocode",
  "version": "0.12.6",
  "description": "Cocode opens coding-agent workflows to any LLM — OpenAI, Gemini, DeepSeek, Ollama, and 200+ models",
  "type": "module",
  "bin": {
    "cocode": "./bin/cocode"
  },
  "exports": {
    "./package.json": "./package.json",
    "./dist/cli.mjs": "./dist/cli.mjs",
    "./sdk": {
      "types": "./src/entrypoints/sdk.d.ts",
      "import": "./dist/sdk.mjs"
    }
  },
  "files": [
    "bin/",
    "dist/cli.mjs",
    "dist/sdk.mjs",
    "src/entrypoints/sdk.d.ts",
    "src/entrypoints/sdk/coreTypes.generated.ts",
    "README.md"
  ],
  "scripts": {
    "build": "npx tsx scripts/build-node.ts",
    "integrations:generate": "bun run scripts/generate-integrations-artifacts.ts",
    "integrations:check": "bun run scripts/generate-integrations-artifacts.ts --check",
    "dev": "npm run build && node dist/cli.mjs",
    "dev:profile": "npx tsx scripts/provider-launch.ts",
    "dev:profile:fast": "npx tsx scripts/provider-launch.ts auto --fast --bare",
    "dev:codex": "npx tsx scripts/provider-launch.ts codex",
    "dev:openai": "npx tsx scripts/provider-launch.ts openai",
    "dev:gemini": "npx tsx scripts/provider-launch.ts gemini",
    "dev:ollama": "npx tsx scripts/provider-launch.ts ollama",
    "dev:ollama:fast": "npx tsx scripts/provider-launch.ts ollama --fast --bare",
    "dev:atomic-chat": "npx tsx scripts/provider-launch.ts atomic-chat",
    "profile:init": "npx tsx scripts/provider-bootstrap.ts",
    "profile:recommend": "npx tsx scripts/provider-recommend.ts",
    "profile:auto": "npx tsx scripts/provider-recommend.ts --apply",
    "profile:codex": "npm run profile:init -- --provider codex --model codexplan",
    "profile:fast": "npm run profile:init -- --provider ollama --model llama3.2:3b",
    "profile:code": "npm run profile:init -- --provider ollama --model qwen2.5-coder:7b",
    "dev:fast": "npm run profile:fast && npm run dev:ollama:fast",
    "dev:code": "npm run profile:code && npm run dev:profile",
    "dev:grpc": "npx tsx scripts/start-grpc.ts",
    "dev:grpc:cli": "npx tsx scripts/grpc-cli.ts",
    "start": "node dist/cli.mjs",
    "test": "echo 'No tests available (bun:test runner removed)'",
    "test:coverage": "echo 'No tests available'",
    "test:coverage:ui": "echo 'No tests available'",
    "security:pr-scan": "npx tsx scripts/pr-intent-scan.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node dist/cli.mjs --version",
    "verify:privacy": "npx tsx scripts/verify-no-phone-home.ts",
    "build:verified": "npm run build && npm run verify:privacy",
    "doctor:runtime": "npx tsx scripts/system-check.ts",
    "doctor:runtime:json": "npx tsx scripts/system-check.ts --json",
    "doctor:report": "npx tsx scripts/system-check.ts --out reports/doctor-runtime.json",
    "hardening:check": "npm run smoke && npm run doctor:runtime",
    "hardening:strict": "npm run typecheck && npm run hardening:check",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "0.3.0",
    "@anthropic-ai/foundry-sdk": "0.2.3",
    "@anthropic-ai/sandbox-runtime": "0.0.46",
    "@anthropic-ai/sdk": "0.91.1",
    "@anthropic-ai/vertex-sdk": "0.16.0",
    "@commander-js/extra-typings": "12.1.0",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@mendable/firecrawl-js": "4.23.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@orama/orama": "^3.1.18",
    "@orama/plugin-data-persistence": "^3.1.18",
    "@vscode/ripgrep": "^1.17.1",
    "ajv": "8.18.0",
    "auto-bind": "5.0.1",
    "axios": "1.15.2",
    "bidi-js": "1.0.3",
    "chalk": "5.6.2",
    "chokidar": "4.0.3",
    "cli-boxes": "3.0.0",
    "cli-highlight": "2.1.11",
    "code-excerpt": "4.0.0",
    "commander": "12.1.0",
    "cross-spawn": "7.0.6",
    "diff": "8.0.3",
    "duck-duck-scrape": "^2.2.7",
    "emoji-regex": "10.6.0",
    "env-paths": "3.0.0",
    "execa": "9.6.1",
    "fflate": "0.8.2",
    "figures": "6.1.0",
    "fuse.js": "7.1.0",
    "get-east-asian-width": "1.5.0",
    "google-auth-library": "9.15.1",
    "https-proxy-agent": "7.0.6",
    "ignore": "7.0.5",
    "indent-string": "5.0.0",
    "jsonc-parser": "3.3.1",
    "lodash-es": "4.18.1",
    "lru-cache": "11.2.7",
    "marked": "15.0.12",
    "p-map": "7.0.4",
    "picomatch": "4.0.4",
    "proper-lockfile": "4.1.2",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-compiler-runtime": "1.0.0",
    "react-reconciler": "0.33.0",
    "semver": "7.7.4",
    "sharp": "^0.34.5",
    "shell-quote": "1.8.3",
    "signal-exit": "4.1.0",
    "stack-utils": "2.0.6",
    "strip-ansi": "7.2.0",
    "supports-hyperlinks": "3.2.0",
    "tree-kill": "1.2.2",
    "turndown": "7.2.2",
    "type-fest": "4.41.0",
    "undici": "7.24.6",
    "usehooks-ts": "3.1.1",
    "vscode-languageserver-protocol": "3.17.5",
    "wrap-ansi": "9.0.2",
    "ws": "8.20.0",
    "xss": "1.0.15",
    "yaml": "2.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yanzhenqiang/cocode.git"
  },
  "keywords": [
    "claude-code",
    "openai",
    "llm",
    "cli",
    "agent",
    "deepseek",
    "ollama",
    "gemini"
  ],
  "license": "SEE LICENSE FILE",
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  }
}
